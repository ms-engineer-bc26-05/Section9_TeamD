# このファイルをコピーして .env を作成する（READMEの手順を参照）
# ここに書いているのは開発用のダミー値。本物の秘密情報はこのファイルに書かないこと

# 実行環境（development / production）とログレベル
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL（開発用のダミー値）
POSTGRES_USER=porori
POSTGRES_PASSWORD=porori_dev_password
POSTGRES_DB=porori

# backendコンテナから見たDB・Redisの接続先（サービス名で指定する）
DATABASE_URL=postgresql://porori:porori_dev_password@db:5432/porori
REDIS_URL=redis://redis:6379/0

# 利用回数制限（Issue #57）。上限は0以上の整数か unlimited（無制限）を指定する
USAGE_FREE_CONSULTATION_LIMIT=3
USAGE_PREMIUM_CONSULTATION_LIMIT=30
USAGE_FREE_MEMO_LIMIT=10
USAGE_PREMIUM_MEMO_LIMIT=100
# 回数をリセットするまでの秒数（30日）
USAGE_PERIOD_SECONDS=2592000
# Redisの接続・処理のタイムアウト（秒）。Issue #57で待ち時間を実測して決定
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_COMMAND_TIMEOUT_SECONDS=0.5

# バックエンドへのアクセスを許可するフロントエンドのURL（カンマ区切り）
CORS_ORIGINS=http://localhost:3000

# ブラウザからFastAPIを呼ぶときのURL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Authentication（公開設定。実際の値は各自の .env だけに保存する）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK（バックエンド）
FIREBASE_PROJECT_ID=
# リポジトリ外に置いたJSON鍵の絶対パス（compose.firebase.yaml 使用時だけ参照する）
FIREBASE_CREDENTIALS_PATH=

# AI相談（秘密情報は各自の .env だけに保存し、共有・記録しない）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_TIMEOUT_SECONDS=30

# Stripe Checkoutからキャンセルした場合の戻り先（秘密情報ではない）
CHECKOUT_CANCEL_URL=http://localhost:3000/plan?checkout=cancelled

# バックエンドの自動リロード（true / false）
# 縦断確認などで相談の一時状態を保ちたいときは false にする
BACKEND_RELOAD=true

# 整理メモの暗号化鍵（値は各自の .env だけに保存し、共有・記録しない）
# 生成例: docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMO_ENCRYPTION_KEY=
